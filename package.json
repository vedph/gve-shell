{
  "name": "gve-shell",
  "version": "3.0.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "build-cor": "ng build @myrmidon/gve-core",
    "build-lib": "pnpm run build-cor",
    "compodoc": "npx compodoc -p tsconfig.doc.json --disablePrivate --includes docs --assetsFolder docs/img",
    "mv-img": "gulp move-docs-img"
  },
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@cisstech/nge": "^18.3.0",
    "@myrmidon/gve-snapshot-view": "^1.2.1",
    "@myrmidon/ngx-mat-tools": "^1.0.1",
    "@myrmidon/ngx-tools": "^2.0.2",
    "@myrmidon/ngx-viz": "^1.0.0",
    "@svgdotjs/svg.js": "^3.2.5",
    "gsap": "^3.13.0",
    "monaco-editor": "^0.54.0",
    "nanoid": "^5.1.6",
    "rxjs": "~7.8.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "^20.0.0",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@types/gsap": "^3.0.0",
    "@types/jest": "^30.0.0",
    "gulp": "^5.0.1",
    "gulp-imagemin": "^9.2.0",
    "jest": "^30.2.0",
    "jest-preset-angular": "^15.0.3",
    "ng-packagr": "^21.0.0",
    "ts-jest": "^29.4.5",
    "typescript": "~5.9.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-arm64-msvc": "^4.53.3"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node"
    }
  }
}
