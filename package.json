{
  "name": "gve-shell",
  "version": "7.0.19",
  "scripts": {
    "ng": "ng",
    "check-libs": "node scripts/check-local-libs.mjs",
    "start": "node scripts/check-local-libs.mjs && ng serve",
    "build": "node scripts/check-local-libs.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test @myrmidon/gve-core --watch=false",
    "test:watch": "ng test @myrmidon/gve-core",
    "test:coverage": "ng test @myrmidon/gve-core --watch=false --coverage",
    "build-libs": "node scripts/build-libs.mjs",
    "build-lib": "node scripts/build-libs.mjs",
    "compodoc": "npx compodoc -p tsconfig.doc.json --disablePrivate --includes docs --assetsFolder docs/img",
    "mv-img": "gulp move-docs-img"
  },
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@myrmidon/gve-snapshot-rendition": "^2.0.11",
    "@myrmidon/ngx-mat-tools": "^3.0.1",
    "@myrmidon/ngx-tools": "^3.0.2",
    "gsap": "^3.15.0",
    "monaco-editor": "^0.55.1",
    "nanoid": "^6.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^5.0.2",
    "gulp": "^5.0.1",
    "gulp-imagemin": "^9.2.0",
    "jsdom": "^30.1.1",
    "ng-packagr": "^22.2.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-arm64-msvc": "^4.63.5"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node"
    }
  }
}
